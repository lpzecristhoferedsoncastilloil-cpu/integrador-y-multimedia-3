{
  "name": "neurogym-test-subsystem",
  "version": "1.0.0",
  "description": "Subsistema de pruebas automatizado e inteligente para Neurogym",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "cucumber-js src/bdd/features/**/*.feature",
    "test:headed": "cucumber-js src/bdd/features/**/*.feature --world-parameters \"{\\\"headed\\\": true}\"",
    "playwright-install": "playwright install chromium"
  },
  "keywords": [
    "testing",
    "qa",
    "playwright",
    "cucumber",
    "faker",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.19.2",
    "mysql2": "^3.22.5",
    "nodemailer": "^8.0.10"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.8.0",
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.44.1",
    "playwright": "^1.44.1"
  }
}
